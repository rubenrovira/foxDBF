
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
**/bin/
obj/
**/Debug/
DebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# JetBrains Rider
.idea/

# MacOS files
*.DS_Store

# appSettings.json any environment
appsettings.json
appsettings.*.json
# Docker template config (placeholder secrets only — safe to commit)
!docker-config/appsettings.json
CURL - Laudus API.txt
BackLog.xlsx
VFP/token.txt
/VFP/GetStru.txt
/VFP/*.BAK
/VFP/*.FXP
/VFP/*.ERR
/VFP/*.xml
/Service.Tests/Config.Test.json

companies/

# Local environment files (secrets/tokens) - never commit
.env
.env.*
*.env
!.env.example
!.env.template

# CI login-smoke fixture: commit ci-fixtures/company.zip, but ignore the copy the
# docker-build-linux job unzips from it at build time.
/ci-fixtures/company/

# Local runtime company data dir (compose default COMPANY_DATA_DIR); populated by copying
# a company folder in for local testing. Never commit real/sample company DBFs here.
/sample-data/


/foxDBF-fork.slnx
