<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Mirror Core: don't require an XML doc on every public member (CS1591); minor doc-tag
         polish (CS1734). -->
    <NoWarn>$(NoWarn);CS1591;CS1734</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CrossVault.FoxDbf.Highlike</PackageId>
    <Version>0.6.0</Version>
    <Authors>CrossVault</Authors>
    <Company>CrossVault</Company>
    <Description>Highlike — the opt-in high-performance accelerator for CrossVault.FoxDbf. Augments the Core Rushmore query optimizer with a .stx statistics sidecar (NDV / min-max / histograms / most-common-values), a cost-based planner (AND-ordering, index-vs-scan, guard lifting), and a cross-query decoded-index cache with change-token + FileSystemWatcher invalidation. Statistics and caches are HINTS ONLY: the result set is always identical to the Core optimizer and to a full scan. Dependency direction is strictly Highlike -> Core.</Description>
    <PackageTags>foxpro;visualfoxpro;dbf;cdx;rushmore;query;optimizer;statistics;histogram;cache;accelerator</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Tests.Public" />
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Tests.Internal" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core becomes the package dependency (CrossVault.FoxDbf). The Expressions assembly is
         BUNDLED inside the Core package, so it must NOT also surface as a package dependency here
         (there is no standalone CrossVault.FoxDbf.Expressions package) — PrivateAssets="all"
         keeps the compile-time project reference without emitting a NuGet dependency. -->
    <ProjectReference Include="..\CrossVault.FoxDbf\CrossVault.FoxDbf.csproj" />
    <ProjectReference Include="..\CrossVault.FoxDbf.Expressions\CrossVault.FoxDbf.Expressions.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
