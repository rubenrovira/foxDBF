<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1734</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- PackageId intentionally differs from AssemblyName/RootNamespace (CrossVault.FoxDbf.MicroVfp) -
         "CrossVault.microVFP" is the public-facing package name. -->
    <PackageId>CrossVault.microVFP</PackageId>
    <Version>0.7.0</Version>
    <Authors>CrossVault</Authors>
    <Company>CrossVault</Company>
    <Description>A minimal, embeddable Visual FoxPro 9 stored-procedure interpreter: a tree-walking interpreter for real VFP9 .prg source (PROCEDURE/FUNCTION definitions, control flow incl. SCAN and FOR EACH, VFP dynamic scoping (LOCAL/PRIVATE/PUBLIC), by-value/by-reference parameter passing, ON ERROR/AERROR error handling, generalised &amp;macro execution, #DEFINE/#IF preprocessing) running against a live CrossVault.FoxDbf VfpSession - so .prg code that opens tables, seeks, scans, and writes records operates on the same byte-compatible, Rushmore-optimized engine as the rest of CrossVault.FoxDbf. Runs the data side of real business logic: an INDEX ON TAG/TO write model (structural and non-structural .cdx, standalone .idx, SET ORDER/INDEX, REINDEX, DELETE TAG, tag introspection), REAL row/table buffering (CURSORSETPROP/CURSORGETPROP Buffering 1-5, TABLEUPDATE/TABLEREVERT, OLDVAL/CURVAL/GETFLDSTATE), SET RELATION/SET SKIP parent-child navigation, auto-firing DBC RULEs and referential-integrity triggers (== VFP9), and a broad runtime function library (string/date/math, arrays, TRANSFORM/VARTYPE/STRCONV/TEXTMERGE, session &amp; index introspection). For running real-world VFP9 business-logic stored procedures on .NET without a Visual FoxPro installation. Note the honest limits: LOCATE/CONTINUE parse but are no-ops today (use SCAN); SET DATASESSION is a single-session stub; the interpreter-level RLOCK/FLOCK always succeed (single in-process writer).</Description>
    <PackageTags>foxpro;visualfoxpro;vfp;prg;interpreter;stored-procedure;dsl;xbase</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- CrossVault.FoxDbf.Sql was merged into CrossVault.FoxDbf (same package now, no cycle since
         VfpSession/SqlParser live there); reference Core directly for a normal nuspec dependency. -->
    <ProjectReference Include="..\CrossVault.FoxDbf\CrossVault.FoxDbf.csproj" />
    <ProjectReference Include="..\CrossVault.FoxDbf.Expressions\CrossVault.FoxDbf.Expressions.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Tests.Public" />
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Tests.Internal" />
    <!-- The ADO.NET provider reads interpreter state (Memory) for SP results/EnforceRules; the
         interpreter internals are deliberately NOT public API (finding 5.11) - same sibling-IVT
         pattern Core already uses for Data. Decoupling via a public seam is tracked as 5.12. -->
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Data" />
  </ItemGroup>

</Project>
